---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import { site } from '../../site';

export async function getStaticPaths() {
  const finds = await getCollection('finds', ({ data }) => !data.draft);
  return finds.map((find) => ({ params: { id: find.id }, props: { find } }));
}
const { find } = Astro.props;
const d = find.data;
const { Content } = await render(find);
const typeLabel: Record<string, string> = {
  restaurant: 'Restaurant', cafe: 'Café', bar: 'Bar', hotel: 'Hotel', 'day-out': 'Day out', event: 'Event', shop: 'Shop',
};
const dateStr = d.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
// Instagram's embed wants the bare permalink, without tracking parameters.
const reelUrl = d.reel ? d.reel.split('?')[0].replace(/\/?$/, '/') : null;
---
<Base title={d.title} description={d.summary}>
  <article>
    <header class="head">
      <div class="wrap head__inner">
        {d.example && <p class="example">Example article — placeholder content to show the layout.</p>}
        <div class="meta">
          <span class="eyebrow">{d.area} · {typeLabel[d.type]}</span>
          {d.partnership === 'paid' && <span class="pill pill--paid">Paid partnership</span>}
          {d.partnership === 'gifted' && <span class="pill pill--gifted">Gifted visit</span>}
        </div>
        <h1>{d.title}</h1>
        <p class="lede">{d.summary}</p>
        <p class="byline">{d.venue} · <time datetime={d.date.toISOString()}>{dateStr}</time></p>
      </div>
    </header>

    {d.cover && !reelUrl && (
      <div class="wrap"><img class="cover" src={d.cover} alt={d.coverAlt ?? ''} /></div>
    )}

    <div class="wrap body">
      <div class="prose">
        {reelUrl && (
          <figure class="reel">
            <blockquote class="instagram-media" data-instgrm-permalink={reelUrl} data-instgrm-version="14">
              <a href={reelUrl} target="_blank" rel="noopener">Watch this reel on Instagram</a>
            </blockquote>
            <script async src="https://www.instagram.com/embed.js" is:inline></script>
          </figure>
        )}
        <Content />
      </div>
      <aside class="side">
        {d.reel && (
          <div class="stack stack--tight">
            <span class="eyebrow">Watch the reel</span>
            <a href={d.reel} target="_blank" rel="noopener">Open on Instagram →</a>
          </div>
        )}
        <div class="stack stack--tight">
          <span class="eyebrow">More like this</span>
          <a href="/finds/">All finds</a>
        </div>
        <div class="stack stack--tight">
          <span class="eyebrow">Own a place like this?</span>
          <a href="/work-with-me/">Work with Amy</a>
        </div>
        <div class="stack stack--tight">
          <span class="eyebrow">Follow</span>
          <a href={site.instagramUrl} target="_blank" rel="noopener">{site.instagram}</a>
        </div>
      </aside>
    </div>
  </article>
</Base>

<style>
  .head { background: var(--blush); border-bottom: 1px solid var(--line); }
  .head__inner { padding-block: clamp(2.5rem, 6vw, 5rem); display: flex; flex-direction: column; gap: 1rem; }
  .meta { display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center; }
  .byline { font-size: 0.9rem; color: var(--mute); }
  .example { font-size: 0.8rem; color: var(--rose-deep); border: 1px dashed var(--rose); padding: 0.4rem 0.8rem; border-radius: 4px; display: inline-block; max-width: none; }
  .cover { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 4px; margin-top: 2rem; }
  .body { display: grid; gap: 3rem; padding-block: clamp(2.5rem, 6vw, 4rem); grid-template-columns: 1fr; }
  @media (min-width: 900px) { .body { grid-template-columns: minmax(0, 1fr) 240px; } }
  .side { display: flex; flex-direction: column; gap: 1.75rem; font-size: 0.95rem; border-top: 1px solid var(--line); padding-top: 1.5rem; }
  @media (min-width: 900px) { .side { border-top: 0; border-left: 1px solid var(--line); padding-top: 0; padding-left: 1.5rem; position: sticky; top: 2rem; align-self: start; } }
  .side a { text-decoration: none; }
  .reel { margin: 0 0 2.5rem; max-width: 540px; }
  .reel .instagram-media { margin: 0 !important; min-width: 0 !important; width: 100% !important; }
</style>
