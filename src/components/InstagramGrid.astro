---
// Latest reels on the home page, from src/data/reels.json (refresh with scripts/build-reels.mjs).
import ReelEmbed from './ReelEmbed.astro';
import reels from '../data/reels.json';
import { site } from '../site';
const latest = reels.slice(0, 3);
---
<section class="section">
  <div class="wrap stack">
    <div class="ig__head">
      <div class="stack stack--tight">
        <span class="eyebrow">Latest on Instagram</span>
        <h2>Watched over two million times since July</h2>
      </div>
      <div class="ig__actions">
        <a class="more" href="/reels/">All {reels.length} reels →</a>
        <a class="button button--ghost" href={site.instagramUrl} target="_blank" rel="noopener">Follow {site.instagram}</a>
      </div>
    </div>
    <ul class="ig">
      {latest.map((r) => (
        <li>
          <ReelEmbed url={r.url} title={r.title} />
          <h3><a href={`/reels/${r.code}/`}>{r.title}</a></h3>
        </li>
      ))}
    </ul>
  </div>
  <script async src="https://www.instagram.com/embed.js" is:inline></script>
</section>

<style>
  .ig__head { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; flex-wrap: wrap; }
  .ig__actions { display: flex; align-items: center; gap: 1.5rem; flex-wrap: wrap; }
  .more { text-decoration: none; font-size: 0.9rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--rose-deep); }
  .ig { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem 1.5rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr)); }
  .ig li { display: flex; flex-direction: column; gap: 0.75rem; min-width: 0; }
  .ig h3 { font-size: 1.25rem; }
  .ig h3 a { text-decoration: none; }
  .ig h3 a:hover { color: var(--rose-deep); }
</style>
